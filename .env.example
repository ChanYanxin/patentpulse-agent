# For optional model-controlled tool calling ONLY; never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional override; includes demo/ and your_docs/ subdirs.
# TECHINTEL_CORPUS_DIR=/absolute/path/to/corpus
# TECHINTEL_MEMORY_DB=./notes.sqlite
